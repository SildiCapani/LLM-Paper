{
  "_comment": "Generation protocol. Placeholders: {model}, {prompt}, {last_message_file}. Every CLI gets its own config directory under homes/ (login once, see ANLEITUNG.md). Fields marked VERIFY must be checked after installation.",
  "samples": 5,
  "seed": 20261025,
  "timeout_s": 900,
  "pause_s": 5,
  "max_technical_retries": 2,
  "retry_backoff_s": [
    30,
    120
  ],
  "rate_limit_patterns": [
    "rate limit",
    "rate_limit",
    "usage limit",
    "quota",
    "429",
    "resource_exhausted",
    "resource exhausted",
    "too many requests",
    "limit reached",
    "try again later"
  ],
  "tools": {
    "claude": {
      "cli": "Claude Code",
      "package": "@anthropic-ai/claude-code",
      "model": "claude-opus-5-5",
      "config_env": "CLAUDE_CONFIG_DIR",
      "config_subdir": "",
      "env": {
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
        "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
      },
      "version_cmd": [
        "claude",
        "--version"
      ],
      "cmd": [
        "claude",
        "-p",
        "--model",
        "{model}",
        "--effort",
        "{effort}",
        "--tools",
        "",
        "--output-format",
        "json",
        "--no-session-persistence",
        "--strict-mcp-config",
        "--disable-slash-commands",
        "{prompt}"
      ],
      "stdin_prompt": false,
      "parser": "claude_json"
    },
    "codex": {
      "cli": "Codex CLI",
      "package": "@openai/codex",
      "model": "gpt-6.1-sol",
      "_model_note": "Highest-priority listed model in `codex debug models` (2026-10-27); default reasoning level medium (B10)",
      "config_env": "CODEX_HOME",
      "config_subdir": "",
      "env": {},
      "version_cmd": [
        "codex",
        "--version"
      ],
      "cmd": [
        "codex",
        "exec",
        "-m",
        "{model}",
        "-c",
        "model_reasoning_effort=\"{effort}\"",
        "-c",
        "web_search=\"disabled\"",
        "--disable",
        "multi_agent",
        "--disable",
        "image_generation",
        "--disable",
        "apps",
        "--disable",
        "plugins",
        "--disable",
        "remote_plugin",
        "--disable",
        "browser_use",
        "--disable",
        "browser_use_external",
        "--disable",
        "in_app_browser",
        "--disable",
        "computer_use",
        "--disable",
        "goals",
        "--disable",
        "sleep_tool",
        "--disable",
        "view_image",
        "--disable",
        "hooks",
        "--disable",
        "skill_search",
        "--disable",
        "tool_suggest",
        "--disable",
        "shell_tool",
        "--disable",
        "unified_exec",
        "--disable",
        "workspace_dependencies",
        "--sandbox",
        "read-only",
        "--skip-git-repo-check",
        "--ephemeral",
        "--ignore-user-config",
        "--json",
        "--color",
        "never",
        "-o",
        "{last_message_file}",
        "-"
      ],
      "stdin_prompt": true,
      "parser": "codex_jsonl",
      "_effort_note": "Verified 2026-10-27: model_reasoning_effort accepted by codex exec 0.164.0",
      "_tools_note": "Feature flags remove web search, shell, image generation, browser, plugins, MCP apps (F21). Core tools (spawn_agent, apply_patch, request_user_input) cannot be disabled; tool calls are logged."
    },
    "gemini": {
      "cli": "Antigravity CLI",
      "package": "https://antigravity.google/cli/install.sh",
      "_history": "Gemini CLI stopped serving individual/Google AI Pro accounts on 2026-06-18; Antigravity CLI (agy) is Google's official successor.",
      "model": "gemini-4-argon-medium",
      "_model_note": "Most capable Gemini model from `agy models` (2026-10-27); suffix -medium = reasoning effort (B13)",
      "config_env": "HOME",
      "_config_note": "agy keeps settings in ~/.gemini/antigravity-cli/ and credentials in the OS keyring; an isolated HOME separates the settings, the keyring login is shared",
      "config_subdir": ".gemini/antigravity-cli",
      "env": {},
      "settings_file": "settings.json",
      "settings": {},
      "version_cmd": [
        "agy",
        "--version"
      ],
      "cmd": [
        "agy",
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--output-format",
        "stream-json",
        "--print-timeout",
        "15m",
        "--disable-slash-commands",
        "--sandbox"
      ],
      "stdin_prompt": false,
      "parser": "agy_stream_json"
    }
  },
  "reasoning_effort": "medium",
  "_effort_note": "Uniform nominal effort for all tools (decision B13). Antigravity encodes it in the model id."
}
